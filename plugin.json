{
  "manifestVersion": 2,
  "publisher": "personal",
  "name": "reauth-manager",
  "displayName": "账号重新授权",
  "version": "0.1.115+host.3.55.2",
  "description": "沿用账号备注及绑定代理重新授权并写回原账号",
  "license": "MIT",
  "engines": {
    "codex-proxy-rs": ">=3.54.5, <3.56.0"
  },
  "main": "bin/reauth-manager",
  "runtime": "trustedProcess",
  "contributes": {
    "management": {
      "version": 2
    },
    "maintenance": {}
  },
  "configurationSchema": {
    "type": "object",
    "properties": {
      "protectedManagementUrl": {
        "type": "string",
        "default": "",
        "title": "本机受保护管理入口",
        "description": "例如 http://127.0.0.1:18138，仅用于新增账号导入，不接受上游或代理 URL"
      },
      "mailshopRtApiKey": {
        "type": "string",
        "minLength": 8,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9_-]+$",
        "title": "GMX Mailshop RT API Key",
        "description": "可选。允许符合条件的 @gmx.com 异常账号在明确登录失败后回退，或手动重试时直接向 Mailshop 提供 GPT 密码和 2FA 密钥获取 RT，由 RS 核验后写回。"
      },
      "mailcomKey": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9_-]+$",
        "title": "Mailcom 邮箱验证码 API Key",
        "description": "可选。原生 OAuth 要求邮箱验证码时，使用账号备注中的邮箱密码向 Mailcom 获取验证码；仅对四段式备注生效。"
      },
      "mailshopRtEmails": {
        "type": "array",
        "maxItems": 256,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 9, "maxLength": 254},
        "title": "Mailshop RT 允许的邮箱",
        "description": "可选。不填写时使用常规 GMX 规则；空列表拒绝所有邮箱。"
      }
    },
    "additionalProperties": false
  },
  "secretFields": ["mailshopRtApiKey", "mailcomKey"],
  "resources": {
    "web/index.html": "text/html",
    "web/app.js": "text/javascript",
    "web/app.css": "text/css",
    "runtime/runtime.tar.gz": "application/gzip",
    "legal/NOTICE.md": "text/plain",
    "legal/Apache-2.0.txt": "text/plain"
  },
  "state": [
    {
      "namespace": "reauth-manager",
      "schemaVersion": 1,
      "schema": {
        "type": "object"
      },
      "maximumRecords": 10,
      "maximumBytes": 1048576,
      "maximumValueBytes": 262144,
      "migratesFrom": []
    }
  ]
}
